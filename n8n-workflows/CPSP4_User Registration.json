    {
      "parameters": {
        "jsCode": "const errors = [];\n\nif (!$input.first().json.body.full_name || $input.first().json.body.full_name.trim() === \"\") {\n  errors.push(\"Full Name is required.\");\n}\n\nif (!$input.first().json.body.client_id || $input.first().json.body.client_id.trim() === \"\") {\n  errors.push(\"Client ID is required.\");\n}\n\nif (!$input.first().json.body.email || $input.first().json.body.email.trim() === \"\") {\n  errors.push(\"Email is required.\");\n}\n\nif (!$input.first().json.body.password || $input.first().json.body.password.length < 8) {\n  errors.push(\"Password must be at least 8 characters.\");\n}\n\n// Basic email format check\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif ($input.first().json.body.email && !emailRegex.test($input.first().json.body.email)) {\n  errors.push(\"Invalid email format.\");\n}\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      success: false,\n      errors\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    \n  }\n}];"
      },
