viderColor":"#858282","orientation":"vertical","strokeStyle":"solid","rightColumn":9.0,"widgetId":"f6jbtp2rp6","capSide":0.0,"minWidth":450.0,"isVisible":true,"version":1.0,"parentId":"l70bkqv66b","renderMode":"CANVAS","isLoading":false,"mobileTopRow":30.0,"responsiveBehavior":"fill","mobileLeftColumn":0.0},{"needsErrorInfo":false,"boxShadow":"{{appsmith.theme.boxShadow.appBoxShadow}}","mobileBottomRow":102.0,"widgetName":"cwChatMessages","borderColor":"#E0DEDE","srcDoc":{"html":"<div id=\"chat-container\">\n  <div id=\"messages\"></div>\n</div>","css":"* {\n  box-sizing: border-box;\n}\n\nhtml,\nbody {\n  margin: 0;\n  padding: 0;\n  width: 100%;\n  height: 100%;\n  font-family: Arial, sans-serif;\n  background: transparent;\n}\n\n#chat-container {\n  width: 100%;\n  height: 100%;\n  overflow-y: auto;\n  overflow-x: hidden;\n  padding: 12px;\n}\n\n#messages {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.message-row {\n  display: flex;\n  width: 100%;\n}\n\n.message-row.user {\n  justify-content: flex-end;\n}\n\n.message-row.assistant {\n  justify-content: flex-start;\n}\n\n.message-bubble {\n  max-width: 80%;\n  padding: 10px 14px;\n  border-radius: 12px;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n  line-height: 1.5;\n}\n\n.message-row.user .message-bubble {\n  background: #e8f0fe;\n}\n\n.message-row.assistant .message-bubble {\n  background: #f3f4f6;\n}\n\n.sender {\n  font-size: 12px;\n  font-weight: 600;\n  margin-bottom: 6px;\n}\n\n.message-text {\n  font-size: 14px;\n}\n\n.metadata {\n  margin-top: 8px;\n  font-size: 11px;\n  opacity: 0.7;\n}","js":"function renderMessages() {\n  const container = document.getElementById(\"messages\");\n  if (!container) {\n    return;\n  }\n  const messages = appsmith.model.messages || [];\n  container.innerHTML = \"\";\n  messages.forEach(item => {\n    const row = document.createElement(\"div\");\n    row.className = \"message-row \" + (item.sender === \"user\" ? \"user\" : \"assistant\");\n    const bubble = document.createElement(\"div\");\n    bubble.className = \"message-bubble\";\n    const sender = document.createElement(\"div\");\n    sender.className = \"sender\";\n    sender.textContent = item.sender === \"user\" ? \"You\" : \"Support Assistant\";\n    const message = document.createElement(\"div\");\n    message.className = \"message-text\";\n    message.textContent = item.message || \"\";\n    bubble.appendChild(sender);\n    bubble.appendChild(message);\n    if (item.sender === \"assistant\") {\n      const metadataParts = [];\n      if (item.datasource) {\n        metadataParts.push(\"Source: \" + item.datasource);\n      }\n      if (item.intent) {\n        metadataParts.push(\"Intent: \" + item.intent);\n      }\n      if (metadataParts.length > 0) {\n        const metadata = document.createElement(\"div\");\n        metadata.className = \"metadata\";\n        metadata.textContent = metadataParts.join(\" | \");\n        bubble.appendChild(metadata);\n      }\n    }\n    row.appendChild(bubble);\n    container.appendChild(row);\n  });\n  const chatContainer = document.getElementById(\"chat-container\");\n  if (chatContainer) {\n    chatContainer.scrollTop = chatContainer.scrollHeight;\n  }\n}\nappsmith.onReady(() => {\n  renderMessages();\n  appsmith.onModelChange(() => {\n    renderMessages();\n  });\n});"},"isCanvas":false,"topRow":7.0,"bottomRow":52.0,"parentRowSpace":10.0,"type":"CUSTOM_WIDGET","mobileRightColumn":19.0,"shouldScrollContents":true,"dynamicTriggerPathList":[{"key":"onResetClick"}],"parentColumnSpace":17.8974609375,"dynamicBindingPathList":[{"key":"theme"},{"key":"borderRadius"},{"key":"boxShadow"},{"key":"defaultModel"}],"leftColumn":9.0,"defaultModel":"{{\n  {\n    messages: appsmith.store.chatMessages || []\n  }\n}}","borderWidth":"1","theme":"{{appsmith.theme}}","onResetClick":"{{showAlert('Successfully reset!!', '');}}","events":["onResetClick"],"key":"s44mhhugr1","backgroundColor":"#FFFFF