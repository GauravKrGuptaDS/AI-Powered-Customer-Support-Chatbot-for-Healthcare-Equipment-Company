(\"chatMessages\", [\n\t\t\t{\n\t\t\t\tid: \"welcome-1\",\n\t\t\t\tsender: \"assistant\",\n\t\t\t\tmessage: \"Hello! How can I help you today?\"\n\t\t\t}\n\t\t]);\n\t},\n\n\tasync sendMessage() {\n\t\tconst question = inpQuestion.text.trim();\n\n\t\tif (!question) {\n\t\t\tshowAlert(\"Please enter a question\", \"warning\");\n\t\t\treturn;\n\t\t}\n\n\t\t// Get existing messages\n\t\tconst existingMessages = appsmith.store.chatMessages || [];\n\n\t\t// Create user message\n\t\tconst userMessage = {\n\t\t\tid: \"user-\" + Date.now(),\n\t\t\tsender: \"user\",\n\t\t\tmessage: question\n\t\t};\n\n\t\t// Add question to chat history\n\t\tawait storeValue(\"chatMessages\", [\n\t\t\t...existingMessages,\n\t\t\tuserMessage\n\t\t]);\n\n\t\ttry {\n\t\t\t// Run n8n Chat API\n\t\t\tconst apiResponse = await ChatAPI.run();\n\n\t\t\t// Important: use the returned response\n\t\t\tconst assistantMessage = {\n\t\t\t\tid: \"assistant-\" + Date.now(),\n\t\t\t\tsender: \"assistant\",\n\t\t\t\tmessage: apiResponse.response || \"No response received\",\n\t\t\t\tdatasource: apiResponse.datasource || \"\",\n\t\t\t\tintent: apiResponse.intent || \"\"\n\t\t\t};\n\n\t\t\t// Read latest messages again\n\t\t\tconst latestMessages = appsmith.store.chatMessages || [];\n\n\t\t\t// Add assistant response\n\t\t\tawait storeValue(\"chatMessages\", [\n\t\t\t\t...latestMessages,\n\t\t\t\tassistantMessage\n\t\t\t]);\n\n\t\t\tresetWidget(\"inpQuestion\");\n\n\t\t} catch (error) {\n\t\t\tshowAlert(\"Unable to get response from Chat API\", \"error\");\n\t\t}\n\t}\n}","variables":[],"userPermissions":[]},"gitSyncId":"6a4170d381969f12991e69e2_901acae1-5944-4bf3-9522-1d01b34883da","id":"Chat_ChatUtils","deleted":false}],"editModeTheme":{"name":"Default-New","displayName":"Modern","isSystemTheme":true,"deleted":false},"publishedTheme":{"name":"Default-New","displayName":"Modern","isSystemTheme":true,"deleted":false}}